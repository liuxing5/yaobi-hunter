# 妖币猎手 密钥配置
# 复制此文件为 .env 并填入真实值，.env 不会被 git 追踪

BINANCE_API_KEY=your_api_key_here
BINANCE_SECRET=your_secret_here
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
PUSHPLUS_TOKEN=your_pushplus_token_here

# 本地代理（Render 等云平台请留空或删除，否则会连 127.0.0.1 失败）
SCANNER_PROXY=http://127.0.0.1:10808
# Telegram 代理；不填则复用 SCANNER_PROXY
TG_PROXY=http://127.0.0.1:10808

# Dashboard 访问认证（公网部署必填；本地不填则关闭认证）
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_me_to_a_strong_password
